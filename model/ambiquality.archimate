    <folder name="Infrastruktura" id="id-d868d12036e147f29d5afd4ce2563128">
      <element xsi:type="archimate:SystemSoftware" name="Podman" id="id-8236020e9b624ff5a496c232a7b2d3f5">
        <documentation>Kontejnerizační software https://podman.io/</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="PostgreSQL" id="id-53138be34a804acd89553b7a608332ae">
        <documentation>Relační databáze; hostuje schémata auth, evidence, ieq.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="TimescaleDB" id="id-5ab83552a05c42cd917c6cb90059fef8">
        <documentation>Rozšíření PostgreSQL pro časové řady; hypertabulka measurements.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Redis" id="id-9a533e4d878c4de09d17f76ed2573f9b">
        <documentation>In-memory úložiště; durabilní streamy (fronta) a cache.</documentation>
      </element>
      <element xsi:type="archimate:SystemSoftware" name="Caddy" id="id-66c95fbb2d6f451896aebb0c4a2447d7">
        <documentation>HTTP server / reverzní proxy s automatickým TLS.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Databázová služba" id="id-588a0977325f4eecbfcfca3c0ea7074c">
        <documentation>Technologická služba relačního a časového úložiště (PostgreSQL/TimescaleDB).</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="HTTP proxy" id="id-3ee39e8f8b4044ac926a8099e9a6ac50">
        <documentation>Technologická služba ingress/směrování (Caddy).</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Cache služba" id="id-538bb5f6401d4748b22c1df09c9f2e92">
        <documentation>Technologická služba cache (Redis).</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Souborová služba" id="id-a1d121fb3ea64ca0885023a39bd1e90c">
        <documentation>Technologická služba objektového/souborového úložiště archivů.</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="API sestavení" id="id-80e4463721db40fbb28eecf5ae3baad1"/>
      <element xsi:type="archimate:Artifact" name="Frontend sestava" id="id-bb682e19dd624895bcfdaccdce07f4fc"/>
      <element xsi:type="archimate:Artifact" name="Schéma databáze" id="id-a2200cbaafcd434d971609222f1f2066"/>
      <element xsi:type="archimate:Artifact" name="OpenAPI specifikace" id="id-5872ebb70a5848d9b06df6317054adc4"/>
      <element xsi:type="archimate:Artifact" name="CSV archiv" id="id-c89ca4cbad704793878e70366d67d273"/>
      <element xsi:type="archimate:Node" name="Hostitelský server" id="id-5f764c78f8af4ef3afce658f03e992d0">
        <documentation>Jediný hostitelský server provozující Podman a všechny kontejnery.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="postgres-container" id="id-0d8c15f3ce734513a88102c931785f98">
        <documentation>Kontejner PostgreSQL + TimescaleDB; databáze auth, evidence, ieq.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="redis-container" id="id-ea9cf49e07fc456da3ce4853867c56c7">
        <documentation>Kontejner Redis; durabilní stream (AOF appendfsync always) + cache.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="caddy-container" id="id-ab0ef66f2aa140be9d690eefd9c43307">
        <documentation>Kontejner Caddy; reverzní proxy / ingress na :8080.</documentation>
      </element>
      <element xsi:type="archimate:TechnologyService" name="Měřicí fronta (Redis Stream)" id="id-d6fb3a0bd8344935ba567eb45c453270">
        <documentation>Durabilní fronta měření (Redis Stream, consumer group). Write-ahead log mezi Ingestion.Api a Ingestion.Worker; XADD při příjmu, XREADGROUP/XACK při zápisu.</documentation>
      </element>
    </folder>
    <folder name="Mapa" id="id-dca1e5a7a8004623a53afbc9ca900039">
      <element xsi:type="archimate:Node" name="webapp" id="id-7b65cdc0334b4c05842546cd7e2bc606">
        <documentation>Kontejner statické SPA (frontend) za Caddy.</documentation>
      </element>
    </folder>
    <folder name="Měření" id="id-abb0a692557f46d09c3d3ffa122ab320">
      <element xsi:type="archimate:Node" name="ingestion-api" id="id-6a401e6964e54e7888fa92d1795e44ca">
        <documentation>Kontejner služby Ingestion.Api (port 6300); zapisuje do Redis streamu.</documentation>
      </element>
      <element xsi:type="archimate:Node" name="ingestion-worker" id="id-1e8356888a444db984115014a24de2c3">
        <documentation>Kontejner workeru Ingestion.Worker; vyprazdňuje Redis stream do TimescaleDB.</documentation>
      </element>
    </folder>
    <folder name="Přístup k datům" id="id-911a2db95f7d4063b9c0438bf5789cec">
      <element xsi:type="archimate:Node" name="public-api" id="id-a286e78c619d4e07b723463e7c4ad043">
        <documentation>Kontejner služby Public.Api (port 6400); read-only.</documentation>
      </element>
    </folder>
  </folder>
