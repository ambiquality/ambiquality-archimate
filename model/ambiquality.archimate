  <folder name="Application" id="id-7e4ec267d836411799b6194fc50401c3" type="application">
    <folder name="Jádro" id="id-f8f83aba3dd044bb8d4797716c19d835">
      <element xsi:type="archimate:DataObject" name="Chybová odpověď" id="id-703a819f8e7a48b1adb3fdfd54e36c06"/>
    </folder>
    <folder name="Auth" id="id-4b22b959f0b647b8a66ce04584edc1e1">
      <element xsi:type="archimate:ApplicationService" name="Autentizace" id="id-a16f4493b67d4035bf7b298d8147e583">
        <documentation>Aplikační služba ověření identity a správy relací (JWT).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Auth.Api" id="id-0c9beebc6ee14e3cb70b5f64b3a23f8e">
        <documentation>Autentizační služba: registrace, přihlášení, odhlášení, změna údajů, vydávání JWT. Realizuje F01–F04 (UC01–UC04). Kód: src/Ambiquality.Auth.Api.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Přihlašovací údaje" id="id-9b56185a002b454b8a82793591100997"/>
      <element xsi:type="archimate:DataObject" name="Token relace" id="id-2fb7093a4fe64bf792c49203e6940e38"/>
      <element xsi:type="archimate:ApplicationInterface" name="Webové rozhraní provozovatele" id="id-5354a30d36184975b46de8b32c1a0f3a"/>
    </folder>
    <folder name="Evidence" id="id-52d1b702daa742eb9a9d3f9a4870ecd9">
      <element xsi:type="archimate:ApplicationService" name="Správa evidence" id="id-962108361f7443c69ad1a5f68605f6d3">
        <documentation>Aplikační služba CRUD a časové verze evidovaných objektů.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Evidence.Api" id="id-d53126de83174dfabfa27f6914c5ea43">
        <documentation>Evidence budov, místností a senzorů s atributovou časovou verzí (tstzrange, btree_gist exclusion). Realizuje F05–F09 (UC05–UC09). Kód: src/Ambiquality.Evidence.Api.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data budovy" id="id-980c7901f7e0489eab82af642a071dc0"/>
      <element xsi:type="archimate:DataObject" name="Data místnosti" id="id-a44a788146c24a708e7089b8a3167787"/>
      <element xsi:type="archimate:DataObject" name="Data senzoru" id="id-b099651b36b3413b8843577e8fe756ee"/>
    </folder>
    <folder name="Měření" id="id-f734a5d470d84fe88e0a7c9dc30ed3dd">
      <element xsi:type="archimate:ApplicationService" name="Příjem měření" id="id-c2032ad4309644c8b73f72b8d61c5c2d">
        <documentation>Aplikační služba validace a zařazení příchozích měření do fronty.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Ingestion.Api" id="id-4c069b0b72ab417eb7f259f0c7f3e6c3">
        <documentation>Synchronně validuje dávku měření (senzor aktivní, veličina/jednotka, rozsah) a durabilně ji zařadí do Redis streamu; vrací 202, nezapisuje DB. Akceptační polovina F10/UC10. Kód: src/Ambiquality.Ingestion.Api.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Zpráva o měření" id="id-c0b2af95a4b14378a5e72427a4d18770"/>
      <element xsi:type="archimate:DataObject" name="Data měření" id="id-547fd1c3273e485f84e42fe8f5790af0"/>
      <element xsi:type="archimate:ApplicationFunction" name="Validace měření" id="id-16c919a049bc4918aae24fa425898c1f">
        <documentation>Funkce kontroly senzoru, veličiny/jednotky a rozsahu hodnoty (dávka all-or-nothing).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Ingestion.Worker" id="id-f16edf30eb98478aa075cdf3cc09cb62">
        <documentation>Background worker: vybírá měření z Redis streamu (consumer group) a hromadně zapisuje do TimescaleDB hypertabulky idempotentně (ON CONFLICT DO NOTHING). Persistní polovina F10/UC10. Kód: src/Ambiquality.Ingestion.Worker.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Zpracování měření" id="id-11b432dd734542ff9975f7786f91ad5d">
        <documentation>Aplikační služba vyprázdnění fronty a hromadného zápisu měření do hypertabulky.</documentation>
      </element>
    </folder>
    <folder name="Přístup k datům" id="id-fec6b059f9ff4c6eafecb9f69aa51614">
      <element xsi:type="archimate:ApplicationService" name="Čtení dat" id="id-5a5f1b652fbf449a9d1d29096733ee70">
        <documentation>Aplikační služba čtení pozorování a metadat přes veřejné API.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Public.Api" id="id-3330338298f44adfad928eec014309e7">
        <documentation>Read-only open-data API: pozorování (JSON/JSON-LD/CSV), katalog evidence, stránkování, DCAT-AP, OpenAPI. Realizuje F11–F17 (UC11–UC17). Kód: src/Ambiquality.Public.Api.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationFunction" name="Stránkování výsledků" id="id-3004bfbdbd5f44cbbbc72e6c11cddc12">
        <documentation>Funkce stránkování rozsáhlých odpovědí s odkazy na sousední stránky (F13).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationService" name="Poskytování specifikace API" id="id-6bcf1347abb54967b87c08a1ed9be3e7">
        <documentation>Aplikační služba poskytující OpenAPI popis čtecího API (F15).</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Specifikace API" id="id-f86c70cdbe2549758a374dd671f8dad6"/>
      <element xsi:type="archimate:DataObject" name="Parametry dotazu" id="id-4d4fd6a12cf8408aa37700db86638cf2"/>
      <element xsi:type="archimate:DataObject" name="Stránkovaná odpověď" id="id-f960b34742494f5d91324a580783a30e"/>
      <element xsi:type="archimate:ApplicationFunction" name="Validace dotazů" id="id-2d450af3e1034572a482f7e7d8acd759">
        <documentation>Funkce ověření filtračních a vyhledávacích parametrů dotazu (F12, F14).</documentation>
      </element>
    </folder>
    <folder name="Archiv" id="id-eb3af0cb81d047ddaf23d7c4bbb36a45">
      <element xsi:type="archimate:ApplicationService" name="Správa archivu" id="id-01490acd6d2e4f76b8729e92fa3e34ca">
        <documentation>Aplikační služba tvorby a údržby stažitelných archivů měření (F17).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Export.Worker" id="id-2102488a15814d7dac83dbfd4fca9be2">
        <documentation>Background worker: periodicky publikuje měsíční archivy (CSV + JSON-LD, zip) do objektového úložiště a eviduje je pro DCAT distribuce. Produkční strana F17/UC17. Kód: src/Ambiquality.Export.Worker.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Data archivu měření" id="id-0255903e12a544349057dea46a393827"/>
    </folder>
    <folder name="Mapa" id="id-02494ccb5f364231a873157b2d516754">
      <element xsi:type="archimate:ApplicationService" name="Mapové zobrazení" id="id-35b8267b3d904e1ba23b7c508aea6687">
        <documentation>Aplikační služba interaktivní mapy subjektů zájmu a aktuálních hodnot (F18).</documentation>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Webová aplikace" id="id-c1146ec420b048c6a401dbe802c9d371">
        <documentation>Single-page aplikace (React): veřejná mapa měření a administrace evidence. Sama je konzumentem veřejného čtecího API. Realizuje F18/UC18. Repo: ambiquality-frontend.</documentation>
      </element>
      <element xsi:type="archimate:ApplicationInterface" name="Webové rozhraní návštěvníka" id="id-4776c609c21a44eba86215206d29219c"/>
    </folder>
    <folder name="DCAT" id="id-8e51c908723e4e66aed658a724a53335">
      <element xsi:type="archimate:ApplicationService" name="Poskytování katalogizačních metadat" id="id-d5e98fe15ef44e949ce3bcbbef485e4a">
        <documentation>Aplikační služba publikace DCAT-AP metadat datových sad (F16). Součást Public.Api.</documentation>
      </element>
      <element xsi:type="archimate:DataObject" name="Metadata datové sady" id="id-84d72f42910743e4a7b3af2a5a8aa2c8"/>
      <element xsi:type="archimate:DataObject" name="DCAT-AP katalog" id="id-6574770f08bb4edfac00b3876e18f844"/>
    </folder>
    <folder name="Abstrakce" id="id-2847d35395db40228fc555eff3b0eb39">
      <element xsi:type="archimate:DataObject" name="Entitní data" id="id-269f1e6a61d8436189d974122a4ce0af"/>
    </folder>
  </folder>
  <folder name="Technology &amp; Physical" id="id-719df6b698bc43f6bdfdd46e27a7ed3b" type="technology">
    <folder name="Archiv" id="id-01324a0376d1427fa7dc14fa1b4c65b7">
      <element xsi:type="archimate:Node" name="export-worker" id="id-3b9058d8d8e745bdab70b60652c6e29a">
